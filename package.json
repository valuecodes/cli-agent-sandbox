{
  "name": "cli-agent-sandbox",
  "version": "1.0.0",
  "description": "A sandbox project for testing CLI agents",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "run:guestbook": "tsx src/cli/guestbook/main.ts",
    "run:name-explorer": "pnpm -s node:tsx -- src/cli/name-explorer/main.ts",
    "run:scrape-publications": "tsx src/cli/scrape-publications/main.ts",
    "run:etf-backtest": "tsx src/cli/etf-backtest/main.ts",
    "run:agent-evals": "tsx src/cli/agent-evals/main.ts",
    "ai:usage": "tsx src/cli/ai-usage/main.ts",
    "scaffold:cli": "tsx scripts/scaffold-cli.ts",
    "run:fix-pr-comments": "tsx src/cli/fix-pr-comments/main.ts",
    "run:prh-companies": "tsx src/cli/prh-companies/main.ts",
    "run:owner-lookup": "tsx src/cli/owner-lookup/main.ts",
    "run:update-docs": "tsx src/cli/update-docs/main.ts",
    "run:resolve-pr-comments": "tsx src/cli/resolve-pr-comments/main.ts",
    "run:grants-explorer": "pnpm -s node:tsx -- src/cli/grants-explorer/main.ts",
    "node:tsx": "node --disable-warning=ExperimentalWarning --import tsx",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config --local core.hooksPath .githooks || true"
  },
  "keywords": [
    "cli",
    "agent",
    "sandbox",
    "typescript"
  ],
  "author": "Juha Kangas",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "devDependencies": {
    "@openai/agents": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@types/slug": "catalog:",
    "@types/unzipper": "catalog:",
    "dotenv": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lodash-es": "catalog:",
    "marked": "catalog:",
    "node-html-markdown": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "sanitize-html": "catalog:",
    "slug": "catalog:",
    "stream-json": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unzipper": "catalog:",
    "vitest": "catalog:",
    "xlsx": "catalog:",
    "zod": "catalog:",
    "zx": "catalog:"
  }
}
